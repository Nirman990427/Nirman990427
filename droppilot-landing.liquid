  .dp-root .bt__label.is-active { color:var(--text); }
  .dp-root .bt__label em { font-style:normal; font-size:.72rem; color:var(--accent); background:rgba(0,224,184,.12); padding:2px 8px; border-radius:999px; margin-left:4px; }
