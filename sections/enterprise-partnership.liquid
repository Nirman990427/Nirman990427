{%- comment -%}
  Enterprise Partnership — premium dark-mode B2B landing section.
  All CSS/keyframes/SVG ids are scoped to this section instance.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  #cs-corporate-{{ section.id }} {
    --cs-bg: #0f172a;
    --cs-bg-2: #111827;
    --cs-text: #f8fafc;
    --cs-muted: #94a3b8;
    --cs-gold: #d4af37;
    --cs-sage: #10b981;
    --cs-line: rgba(255,255,255,0.06);
    --cs-fill: rgba(255,255,255,0.03);
    --cs-radius: 18px;
    --cs-maxw: 1160px;
  }

  #cs-corporate-{{ section.id }}.cs-wrap {
    position: relative;
    background: var(--cs-bg);
    color: var(--cs-text);
    font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
    isolation: isolate;
  }

  #cs-corporate-{{ section.id }}.cs-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px 520px at 15% -10%, rgba(16,185,129,0.10), transparent 60%),
      radial-gradient(1000px 600px at 100% 0%, rgba(212,175,55,0.08), transparent 55%),
      radial-gradient(1200px 800px at 50% 120%, rgba(30,41,59,0.9), transparent 60%);
    z-index: 0;
    pointer-events: none;
  }

  #cs-corporate-{{ section.id }} .cs-inner { position: relative; z-index: 1; }

  #cs-corporate-{{ section.id }} * { box-sizing: border-box; }

  #cs-corporate-{{ section.id }} .cs-container {
    width: 100%;
    max-width: var(--cs-maxw);
    margin: 0 auto;
    padding: 0 28px;
  }

  #cs-corporate-{{ section.id }} a { color: inherit; text-decoration: none; }

  #cs-corporate-{{ section.id }} h1,
  #cs-corporate-{{ section.id }} h2,
  #cs-corporate-{{ section.id }} h3,
  #cs-corporate-{{ section.id }} .cs-display {
    font-family: 'Bricolage Grotesque', 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.08;
  }

  /* ---------- Sticky nav ---------- */
  #cs-corporate-{{ section.id }} .cs-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background .3s ease, border-color .3s ease, backdrop-filter .3s ease;
    border-bottom: 1px solid transparent;
  }
  #cs-corporate-{{ section.id }} .cs-nav.cs-nav--scrolled {
    background: rgba(15,23,42,0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--cs-line);
  }
  #cs-corporate-{{ section.id }} .cs-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 24px;
  }
  #cs-corporate-{{ section.id }} .cs-brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  #cs-corporate-{{ section.id }} .cs-mark { display: block; }
  #cs-corporate-{{ section.id }} .cs-nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
    margin: 0 auto;
  }
  #cs-corporate-{{ section.id }} .cs-nav-links a {
    color: var(--cs-muted);
    font-size: 14.5px;
    font-weight: 500;
    transition: color .2s ease;
  }
  #cs-corporate-{{ section.id }} .cs-nav-links a:hover { color: var(--cs-text); }

  /* ---------- Buttons ---------- */
  #cs-corporate-{{ section.id }} .cs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    font-weight: 600;
    font-size: 14.5px;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: transform .18s ease, box-shadow .25s ease, background .25s ease, border-color .25s ease;
    white-space: nowrap;
  }
  #cs-corporate-{{ section.id }} .cs-btn--primary {
    background: linear-gradient(180deg, var(--cs-sage), #0c8f63);
    color: #051b12;
    box-shadow: 0 14px 40px -12px rgba(16,185,129,0.55);
  }
  #cs-corporate-{{ section.id }} .cs-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 20px 50px -14px rgba(16,185,129,0.6); }
  #cs-corporate-{{ section.id }} .cs-btn--ghost {
    background: var(--cs-fill);
    color: var(--cs-text);
    border-color: var(--cs-line);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  #cs-corporate-{{ section.id }} .cs-btn--ghost:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.14); }
  #cs-corporate-{{ section.id }} .cs-btn--pill {
    background: var(--cs-fill);
    color: var(--cs-text);
    border-color: var(--cs-line);
    padding: 10px 20px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  #cs-corporate-{{ section.id }} .cs-btn--pill:hover { border-color: var(--cs-gold); color: var(--cs-text); }

  /* ---------- Section scaffolding ---------- */
  #cs-corporate-{{ section.id }} .cs-section { padding: 92px 0; }
  #cs-corporate-{{ section.id }} .cs-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--cs-muted);
    padding: 7px 15px;
    border-radius: 999px;
    border: 1px solid var(--cs-line);
    background: var(--cs-fill);
  }
  #cs-corporate-{{ section.id }} .cs-eyebrow .cs-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--cs-sage);
    box-shadow: 0 0 0 4px rgba(16,185,129,0.18);
  }
  #cs-corporate-{{ section.id }} .cs-section-head { max-width: 640px; }
  #cs-corporate-{{ section.id }} .cs-section-head h2 { font-size: clamp(28px, 4vw, 40px); margin-top: 16px; }
  #cs-corporate-{{ section.id }} .cs-section-head p { color: var(--cs-muted); margin-top: 14px; font-size: 16.5px; }

  /* ---------- Glass card ---------- */
  #cs-corporate-{{ section.id }} .cs-card {
    background: var(--cs-fill);
    border: 1px solid var(--cs-line);
    border-radius: var(--cs-radius);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 30px 80px -40px rgba(0,0,0,0.6);
  }

  /* ---------- Hero ---------- */
  #cs-corporate-{{ section.id }} .cs-hero { padding: 64px 0 84px; }
  #cs-corporate-{{ section.id }} .cs-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 52px;
    align-items: center;
  }
  #cs-corporate-{{ section.id }} .cs-hero h1 {
    font-size: clamp(38px, 6vw, 62px);
    margin-top: 22px;
    background: linear-gradient(180deg, #ffffff, #cbd5e1);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  #cs-corporate-{{ section.id }} .cs-hero-sub {
    color: var(--cs-muted);
    font-size: 17.5px;
    margin-top: 20px;
    max-width: 540px;
  }
  #cs-corporate-{{ section.id }} .cs-hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }

  #cs-corporate-{{ section.id }} .cs-widget { padding: 22px; margin-top: 34px; max-width: 420px; }
  #cs-corporate-{{ section.id }} .cs-widget-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 4px;
  }
  #cs-corporate-{{ section.id }} .cs-widget-row + .cs-widget-row { border-top: 1px solid var(--cs-line); }
  #cs-corporate-{{ section.id }} .cs-widget-label { color: var(--cs-muted); font-size: 14px; }
  #cs-corporate-{{ section.id }} .cs-widget-val { font-weight: 600; font-size: 15px; }
  #cs-corporate-{{ section.id }} .cs-widget-total {
    margin-top: 6px;
    padding: 14px 4px 4px;
    border-top: 1px solid var(--cs-line);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  #cs-corporate-{{ section.id }} .cs-widget-total .cs-big {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 30px;
    font-weight: 700;
    color: var(--cs-gold);
  }

  #cs-corporate-{{ section.id }} .cs-hero-visual { position: relative; }
  #cs-corporate-{{ section.id }} .cs-diagram { width: 100%; height: auto; display: block; }

  /* ---------- Trusted by ---------- */
  #cs-corporate-{{ section.id }} .cs-trusted { padding: 40px 0; border-top: 1px solid var(--cs-line); border-bottom: 1px solid var(--cs-line); }
  #cs-corporate-{{ section.id }} .cs-trusted p {
    text-align: center;
    color: var(--cs-muted);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 24px;
  }
  #cs-corporate-{{ section.id }} .cs-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 44px;
  }
  #cs-corporate-{{ section.id }} .cs-logo {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 600;
    font-size: 20px;
    color: var(--cs-muted);
    opacity: 0.72;
    transition: opacity .25s ease, color .25s ease;
  }
  #cs-corporate-{{ section.id }} .cs-logo:hover { opacity: 1; color: var(--cs-text); }

  /* ---------- Features ---------- */
  #cs-corporate-{{ section.id }} .cs-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  #cs-corporate-{{ section.id }} .cs-feature { padding: 28px; }
  #cs-corporate-{{ section.id }} .cs-feature-icon {
    width: 48px; height: 48px;
    display: grid; place-items: center;
    border-radius: 12px;
    background: rgba(16,185,129,0.10);
    border: 1px solid rgba(16,185,129,0.22);
    color: var(--cs-sage);
    margin-bottom: 18px;
  }
  #cs-corporate-{{ section.id }} .cs-feature h3 { font-size: 19px; }
  #cs-corporate-{{ section.id }} .cs-feature p { color: var(--cs-muted); margin-top: 10px; font-size: 15px; }

  /* ---------- Metrics ---------- */
  #cs-corporate-{{ section.id }} .cs-grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  #cs-corporate-{{ section.id }} .cs-metric { padding: 28px; text-align: left; }
  #cs-corporate-{{ section.id }} .cs-metric-num {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 700;
    color: var(--cs-gold);
    line-height: 1;
  }
  #cs-corporate-{{ section.id }} .cs-metric-label { color: var(--cs-muted); margin-top: 12px; font-size: 14.5px; }

  /* ---------- Protocols ---------- */
  #cs-corporate-{{ section.id }} .cs-protocols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  #cs-corporate-{{ section.id }} .cs-protocol {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 24px;
  }
  #cs-corporate-{{ section.id }} .cs-protocol-check {
    flex: 0 0 auto;
    width: 26px; height: 26px;
    border-radius: 8px;
    display: grid; place-items: center;
    background: rgba(212,175,55,0.12);
    border: 1px solid rgba(212,175,55,0.28);
    color: var(--cs-gold);
  }
  #cs-corporate-{{ section.id }} .cs-protocol span { font-size: 15.5px; font-weight: 500; }

  /* ---------- Team ---------- */
  #cs-corporate-{{ section.id }} .cs-team { padding: 28px; text-align: center; }
  #cs-corporate-{{ section.id }} .cs-avatar {
    width: 76px; height: 76px;
    margin: 0 auto 18px;
    border-radius: 50%;
    display: grid; place-items: center;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 26px;
    color: #051b12;
    background: linear-gradient(135deg, var(--cs-sage), var(--cs-gold));
    box-shadow: 0 18px 40px -18px rgba(16,185,129,0.55);
  }
  #cs-corporate-{{ section.id }} .cs-team h3 { font-size: 18px; }
  #cs-corporate-{{ section.id }} .cs-team p { color: var(--cs-muted); margin-top: 6px; font-size: 14px; }

  /* ---------- CTA band ---------- */
  #cs-corporate-{{ section.id }} .cs-cta-band {
    text-align: center;
    padding: 64px 40px;
    border-radius: 26px;
    background:
      radial-gradient(700px 320px at 50% 0%, rgba(16,185,129,0.14), transparent 60%),
      linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    border: 1px solid var(--cs-line);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  #cs-corporate-{{ section.id }} .cs-cta-band h2 { font-size: clamp(26px, 4vw, 38px); max-width: 680px; margin: 0 auto; }
  #cs-corporate-{{ section.id }} .cs-cta-band .cs-btn { margin-top: 28px; }

  /* ---------- Footer ---------- */
  #cs-corporate-{{ section.id }} .cs-footer {
    border-top: 1px solid var(--cs-line);
    padding: 28px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--cs-muted);
    font-size: 14px;
  }
  #cs-corporate-{{ section.id }} .cs-footer a:hover { color: var(--cs-text); }

  /* ---------- Reveal animation ---------- */
  #cs-corporate-{{ section.id }} [data-cs-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1);
  }
  #cs-corporate-{{ section.id }} [data-cs-reveal].cs-in { opacity: 1; transform: none; }

  @keyframes cs-pulse-{{ section.id }} {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
  @keyframes cs-dash-{{ section.id }} {
    to { stroke-dashoffset: -16; }
  }
  #cs-corporate-{{ section.id }} .cs-node-pulse { animation: cs-pulse-{{ section.id }} 3s ease-in-out infinite; }
  #cs-corporate-{{ section.id }} .cs-flow-line { stroke-dasharray: 4 6; animation: cs-dash-{{ section.id }} 1.4s linear infinite; }

  @media (prefers-reduced-motion: reduce) {
    #cs-corporate-{{ section.id }} .cs-node-pulse,
    #cs-corporate-{{ section.id }} .cs-flow-line { animation: none; }
    #cs-corporate-{{ section.id }} [data-cs-reveal] { transition: none; }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 880px) {
    #cs-corporate-{{ section.id }} .cs-hero-grid { grid-template-columns: 1fr; gap: 40px; }
    #cs-corporate-{{ section.id }} .cs-nav-links { display: none; }
    #cs-corporate-{{ section.id }} .cs-grid-3,
    #cs-corporate-{{ section.id }} .cs-protocols { grid-template-columns: repeat(2, 1fr); }
    #cs-corporate-{{ section.id }} .cs-grid-4 { grid-template-columns: repeat(2, 1fr); }
    #cs-corporate-{{ section.id }} .cs-section { padding: 72px 0; }
  }
  @media (max-width: 620px) {
    #cs-corporate-{{ section.id }} .cs-container { padding: 0 20px; }
    #cs-corporate-{{ section.id }} .cs-grid-3,
    #cs-corporate-{{ section.id }} .cs-grid-4,
    #cs-corporate-{{ section.id }} .cs-protocols { grid-template-columns: 1fr; }
    #cs-corporate-{{ section.id }} .cs-hero-cta { flex-direction: column; align-items: stretch; }
    #cs-corporate-{{ section.id }} .cs-hero-cta .cs-btn { width: 100%; }
    #cs-corporate-{{ section.id }} .cs-logos { gap: 26px; }
    #cs-corporate-{{ section.id }} .cs-logo { font-size: 17px; }
    #cs-corporate-{{ section.id }} .cs-footer { flex-direction: column; gap: 12px; }
    #cs-corporate-{{ section.id }} .cs-cta-band { padding: 48px 22px; }
    #cs-corporate-{{ section.id }} .cs-section { padding: 60px 0; }
  }
</style>

<div id="cs-corporate-{{ section.id }}" class="cs-wrap">
  <div class="cs-inner">

    {%- comment -%} ---------- Sticky nav ---------- {%- endcomment -%}
    <nav class="cs-nav" data-cs-nav>
      <div class="cs-container">
        <div class="cs-nav-row">
          <a href="#cs-top-{{ section.id }}" class="cs-brand">
            <svg class="cs-mark" width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="24" height="24" rx="7" stroke="url(#cs-brand-grad-{{ section.id }})" stroke-width="1.5"/>
              <path d="M8 17V9l10 8V9" stroke="url(#cs-brand-grad-{{ section.id }})" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <defs>
                <linearGradient id="cs-brand-grad-{{ section.id }}" x1="0" y1="0" x2="26" y2="26" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#10b981"/>
                  <stop offset="1" stop-color="#d4af37"/>
                </linearGradient>
              </defs>
            </svg>
            <span>{{ section.settings.brand_name | default: 'Nexus' }}</span>
          </a>
          <div class="cs-nav-links">
            <a href="#cs-program-{{ section.id }}">{{ section.settings.nav_link_1 | default: 'Program' }}</a>
            <a href="#cs-network-{{ section.id }}">{{ section.settings.nav_link_2 | default: 'Network' }}</a>
            <a href="#cs-security-{{ section.id }}">{{ section.settings.nav_link_3 | default: 'Security' }}</a>
          </div>
          <a href="{{ section.settings.portal_link | default: '#' }}" class="cs-btn cs-btn--pill">{{ section.settings.portal_label | default: 'Partner Portal' }}</a>
        </div>
      </div>
    </nav>

    <span id="cs-top-{{ section.id }}"></span>

    {%- comment -%} ---------- Hero ---------- {%- endcomment -%}
    <header class="cs-hero">
      <div class="cs-container">
        <div class="cs-hero-grid">
          <div class="cs-hero-copy" data-cs-reveal>
            <span class="cs-eyebrow"><span class="cs-dot"></span>{{ section.settings.hero_eyebrow | default: 'Infrastructure Division — Now Recruiting' }}</span>
            <h1>{{ section.settings.hero_title | default: 'Join the Enterprise Network' }}</h1>
            <p class="cs-hero-sub">{{ section.settings.hero_subtitle | default: 'We manage high-scale operations processing millions monthly. Our clients need verified infrastructure. Partner with our division, keep full administrator control, and earn daily returns.' }}</p>
            <div class="cs-hero-cta">
              <a href="{{ section.settings.hero_primary_link | default: '#cs-apply-{{ section.id }}' }}" class="cs-btn cs-btn--primary">{{ section.settings.hero_primary_label | default: 'Apply Now' }}</a>
              <a href="#cs-program-{{ section.id }}" class="cs-btn cs-btn--ghost">{{ section.settings.hero_secondary_label | default: 'See the Program' }}</a>
            </div>

            <div class="cs-widget cs-card" data-cs-reveal>
              <div class="cs-widget-row">
                <span class="cs-widget-label">{{ section.settings.widget_label_1 | default: 'Daily Volume' }}</span>
                <span class="cs-widget-val">{{ section.settings.widget_value_1 | default: '£8,600' }}</span>
              </div>
              <div class="cs-widget-row">
                <span class="cs-widget-label">{{ section.settings.widget_label_2 | default: 'Rate' }}</span>
                <span class="cs-widget-val">{{ section.settings.widget_value_2 | default: '5%' }}</span>
              </div>
              <div class="cs-widget-total">
                <span class="cs-widget-label">{{ section.settings.widget_total_label | default: 'Estimated Daily Return' }}</span>
                <span class="cs-big">{{ section.settings.widget_total_value | default: '£430' }}</span>
              </div>
            </div>
          </div>

          <div class="cs-hero-visual" data-cs-reveal>
            <svg class="cs-diagram" viewBox="0 0 460 380" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Account connected to three clients">
              <defs>
                <radialGradient id="cs-glow-{{ section.id }}" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="rgba(16,185,129,0.35)"/>
                  <stop offset="100%" stop-color="rgba(16,185,129,0)"/>
                </radialGradient>
                <linearGradient id="cs-node-grad-{{ section.id }}" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#10b981"/>
                  <stop offset="100%" stop-color="#d4af37"/>
                </linearGradient>
              </defs>

              <ellipse cx="230" cy="120" rx="150" ry="110" fill="url(#cs-glow-{{ section.id }})"/>

              <line class="cs-flow-line" x1="230" y1="120" x2="90"  y2="300" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/>
              <line class="cs-flow-line" x1="230" y1="120" x2="230" y2="320" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/>
              <line class="cs-flow-line" x1="230" y1="120" x2="370" y2="300" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/>

              <circle class="cs-node-pulse" cx="230" cy="120" r="58" fill="rgba(16,185,129,0.06)" stroke="url(#cs-node-grad-{{ section.id }})" stroke-width="1.6"/>
              <circle cx="230" cy="120" r="40" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.14)" stroke-width="1"/>
              <text x="230" y="116" text-anchor="middle" fill="#f8fafc" font-family="Inter, sans-serif" font-size="13" font-weight="600">Your</text>
              <text x="230" y="132" text-anchor="middle" fill="#f8fafc" font-family="Inter, sans-serif" font-size="13" font-weight="600">Account</text>

              <g>
                <circle cx="90" cy="300" r="42" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
                <text x="90" y="305" text-anchor="middle" fill="#94a3b8" font-family="Inter, sans-serif" font-size="12.5" font-weight="500">Client A</text>
              </g>
              <g>
