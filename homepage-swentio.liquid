<!-- Modals -->
<div class="sh-mo" id="sh-mo-privacy-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="sh-mo-privacy-title-{{ section.id }}" onclick="shCloseMo{{ section.id }}(event, 'privacy')">
  <div class="sh-m">
    <button class="sh-mc" type="button" aria-label="Close" onclick="shModal{{ section.id }}('privacy')">&times;</button>
    <h2 id="sh-mo-privacy-title-{{ section.id }}">{{ section.settings.modal_privacy_title | default: "Privacy Policy" }}</h2>
    <div class="sh-md">Last updated: {{ "now" | date: "%B %d, %Y" }}</div>
    <div class="sh-mbody">
      <h3>1. Section Title</h3>
      <p>Privacy policy content goes here. Replace with your actual policy text.</p>
      <h3>2. Section Title</h3>
      <p>More policy content here.</p>
    </div>
  </div>
</div>

<div class="sh-mo" id="sh-mo-terms-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="sh-mo-terms-title-{{ section.id }}" onclick="shCloseMo{{ section.id }}(event, 'terms')">
  <div class="sh-m">
    <button class="sh-mc" type="button" aria-label="Close" onclick="shModal{{ section.id }}('terms')">&times;</button>
    <h2 id="sh-mo-terms-title-{{ section.id }}">{{ section.settings.modal_terms_title | default: "Terms of Service" }}</h2>
    <div class="sh-md">Last updated: {{ "now" | date: "%B %d, %Y" }}</div>
    <div class="sh-mbody">
      <h3>1. Section Title</h3>
      <p>Terms of service content goes here. Replace with your actual terms.</p>
      <h3>2. Section Title</h3>
      <p>More terms content here.</p>
    </div>
  </div>
</div>

<div class="sh-mo" id="sh-mo-security-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="sh-mo-security-title-{{ section.id }}" onclick="shCloseMo{{ section.id }}(event, 'security')">
  <div class="sh-m">
    <button class="sh-mc" type="button" aria-label="Close" onclick="shModal{{ section.id }}('security')">&times;</button>
    <h2 id="sh-mo-security-title-{{ section.id }}">{{ section.settings.modal_security_title | default: "Security" }}</h2>
    <div class="sh-md">Last updated: {{ "now" | date: "%B %d, %Y" }}</div>
    <div class="sh-mbody">
      <h3>1. Section Title</h3>
      <p>Security information goes here. Replace with your actual security details.</p>
      <h3>2. Section Title</h3>
      <p>More security content here.</p>
    </div>
  </div>
</div>

<script>
(function() {
  var sid = '{{ section.id }}';
  var root = document.querySelector('.swentio-homepage[data-section-id="' + sid + '"]');
  if (!root) return;

  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var currency = root.dataset.currency || '£';
  var rate = (parseFloat(root.dataset.rate) || 5) / 100;

  // Scroll-reveal animation (enhancement only - content is visible by default)
  var revealEls = root.querySelectorAll('.sh-reveal');
  if (revealEls.length && 'IntersectionObserver' in window && !reduceMotion) {
    revealEls.forEach(function(el) { el.classList.add('is-hidden'); });
    var ro = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach(function(el) { ro.observe(el); });
    setTimeout(function() {
      revealEls.forEach(function(el) { el.classList.add('visible'); });
    }, 2000);
  }

  // Hero counters
  function anim(el, target, prefix, dur) {
    if (reduceMotion) { el.textContent = prefix + target.toLocaleString(); return; }
    var start = performance.now();
    function up(now) {
      var p = Math.min((now - start) / dur, 1);
      var e = 1 - Math.pow(1 - p, 3);
      el.textContent = prefix + Math.floor(target * e).toLocaleString();
      if (p < 1) requestAnimationFrame(up);
    }
    requestAnimationFrame(up);
  }
  var commTarget = parseInt(root.dataset.comm, 10) || 0;
  var volTarget = parseInt(root.dataset.vol, 10) || 0;
  setTimeout(function() {
    var c = document.getElementById('sh-comm-' + sid);
    var v = document.getElementById('sh-vol-' + sid);
    if (c) anim(c, commTarget, currency, 2000);
    if (v) anim(v, volTarget, currency, 2500);
  }, 500);

  // Calculator slider (initialisé au chargement)
  var s = document.getElementById('sh-vs-' + sid);
  var cv = document.getElementById('sh-cv-' + sid);
  var cc = document.getElementById('sh-cc-' + sid);
  function updateCalc() {
    var vol = parseInt(s.value, 10) || 0;
    var comm = Math.round(vol * rate);
    if (cv) cv.textContent = currency + vol.toLocaleString();
    if (cc) cc.textContent = currency + comm.toLocaleString();
  }
  if (s) {
    s.addEventListener('input', updateCalc);
    updateCalc(); // évite l'affichage des placeholders au chargement
  }

  // FAQ accordion
  root.querySelectorAll('.sh-fqq').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = btn.parentElement;
      var isOpen = item.classList.contains('open');
      root.querySelectorAll('.sh-fq').forEach(function(i) {
        i.classList.remove('open');
        var b = i.querySelector('.sh-fqq');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) { item.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  // Smooth scroll
  root.querySelectorAll('a[href^="#"]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      var href = a.getAttribute('href');
      if (href.length > 1) {
        var t = document.querySelector(href);
        if (t) { e.preventDefault(); t.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' }); }
      }
    });
  });
})();

// Modal functions (global, scoped by section ID)
function shOpenModal{{ section.id }}(name) {
  var el = document.getElementById('sh-mo-' + name + '-{{ section.id }}');
  if (el) { el.classList.add('active'); document.body.style.overflow = 'hidden'; }
}
function shModal{{ section.id }}(name) {
  var el = document.getElementById('sh-mo-' + name + '-{{ section.id }}');
  if (el) { el.classList.remove('active'); document.body.style.overflow = ''; }
}
function shCloseMo{{ section.id }}(e, name) {
  if (e.target === e.currentTarget) shModal{{ section.id }}(name);
}
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    document.querySelectorAll('.sh-mo.active').forEach(function(m) {
      m.classList.remove('active'); document.body.style.overflow = '';
    });
  }
});
</script>

